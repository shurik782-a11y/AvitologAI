OPENROUTER_API_KEY=
ORCHESTRATOR_MODEL=openrouter/free
VISION_MODEL=openrouter/free
IMAGE_MODEL=black-forest-labs/flux.2-flex
DATA_DIR=data
# Must be the public HTTPS URL of the Railway web service (no trailing slash)
PUBLIC_BASE_URL=https://avitologai-production.up.railway.app
# From @BotFather → /token
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed into the app (required in production)
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=
# Railway: Add Variable Reference → Postgres → DATABASE_URL
DATABASE_URL=
